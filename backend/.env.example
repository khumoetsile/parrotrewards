NODE_ENV=development
PORT=3000
DATABASE_URL=mysql://pula_dev:pula_dev_local_only@127.0.0.1:3307/pula_mvp_dev
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
CORS_ORIGINS=http://localhost:4200
# Leave empty locally; production must trust only the host's actual proxy addresses.
TRUST_PROXY=
UPLOAD_DIR=./private-receipts
OCR_CACHE_DIR=./ocr-cache
# Seed only fictional accounts; explicitly supply your own local password.
DEMO_PASSWORD=

# Promotional distribution: leave empty until approved URLs exist.
ANDROID_DOWNLOAD_URL=
IOS_DOWNLOAD_URL=
PROMO_BASE_URL=http://localhost:3000

# Outbound mail (TLS on port 465). Keep credentials in the ignored .env only.
SMTP_HOST=mail.khumo.co.bw
SMTP_PORT=465
SMTP_USER=parrot@khumo.co.bw
SMTP_PASSWORD=
SMTP_FROM="Parrot Rewards <parrot@khumo.co.bw>"

# Public offer artwork (separate from private receipt storage)
OFFER_IMAGE_DIR=./offer-images
