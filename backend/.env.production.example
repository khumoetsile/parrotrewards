NODE_ENV=production
PORT=3000
DATABASE_URL=mysql://CPANEL_USER_DBUSER:URL_ENCODED_PASSWORD@localhost:3306/CPANEL_USER_DATABASE?connection_limit=5&connect_timeout=10
JWT_SECRET=GENERATE_A_UNIQUE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
CORS_ORIGINS=https://admin.example.com
# Set to the actual trusted proxy IP/subnet supplied by your host; empty trusts none.
TRUST_PROXY=
UPLOAD_DIR=/home/CPANEL_USER/apps/parrot/shared/private-receipts
OCR_CACHE_DIR=/home/CPANEL_USER/apps/parrot/shared/ocr-cache
OFFER_IMAGE_DIR=/home/CPANEL_USER/apps/parrot/shared/offer-images
PROMO_BASE_URL=https://api.example.com
ANDROID_DOWNLOAD_URL=
IOS_DOWNLOAD_URL=
SMTP_HOST=mail.example.com
SMTP_PORT=465
SMTP_USER=parrot@example.com
SMTP_PASSWORD=
SMTP_FROM="Parrot Rewards <parrot@example.com>"
